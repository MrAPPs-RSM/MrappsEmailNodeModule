<!-- Two/Three Even Columns (XS: 1/2) -->
{% if tdStyle == 'three_columns' %}
    {% assign tdClass = 'column-3' %}
    {% assign imgSize = 170 %}
{% else %}
    {% if xsInvariate %}
        {% assign tdClass = 'column-2 xs-invariate' %}
    {% else %}
        {% assign tdClass = 'column-2' %}
    {% endif %}
    {% assign imgSize = 270 %}
{% endif %}
<tr>
    <td align="center" valign="top" style="padding: 10px;">
        {% if title != blank %}
            <table cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                    <td style="font-family: sans-serif; font-size: 15px; mso-height-rule: exactly; padding: 10px; text-align: left;">
                        <strong style="color:{{ settings.boldColor }};">{{ title }}</strong>
                    </td>
                </tr>
            </table>
        {% endif %}
        <table cellspacing="0" cellpadding="0" border="0" width="100%">
            <tr>
                {% for row in rows %}
                    <td class="{{ tdClass }}">
                        <table cellspacing="0" cellpadding="0" border="0">
                            <tr>
                                <td style="padding: 10px; text-align: center">
                                    {% if row.link != blank %}
                                        <a href="{{ row.link }}"><img src="{{ row.imageUrl }}" width="{{ imgSize }}"
                                                                      height="{{ imgSize }}" alt="{{ row.alt | default: '' }}" border="0"
                                                                      class="fluid"></a>
                                    {% else %}
                                        <img src="{{ row.imageUrl }}" width="{{ imgSize }}" height="{{ imgSize }}"
                                             alt="{{ row.alt | default: '' }}"
                                             border="0" class="fluid">
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td style="font-family: sans-serif; font-size: 15px; mso-height-rule: exactly; color: {{ settings.textColor }}; padding: 0 10px 10px; text-align: left;"
                                    class="center-on-narrow">
                                    {{ row.description | raw }}
                                </td>
                            </tr>
                        </table>
                    </td>
                {% endfor %}
            </tr>
        </table>
    </td>
</tr>
